{
  "expo": {
    "name": "WheeShare",
    "slug": "wheeshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wheesharelauncher.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EFEA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "dojosoft.zaakirmungrue.wheeshare",
      "adaptiveIcon": {
        "foregroundImage": "./assets/wheesharelauncher.png",
        "backgroundColor": "#F0EFEA"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-video",
      "expo-audio",
      "expo-asset",
      "expo-image-picker",
      "expo-sharing",
      "expo-status-bar",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "eas": {
        "projectId": "364bec3e-dd73-4059-98b0-b395f4384fc4"
      }
    },
    "owner": "mungruez"
  }
}
